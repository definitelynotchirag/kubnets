{
  "name": "urumi",
  "private": true,
  "workspaces": [
    "packages/*",
    "api",
    "dashboard"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev:api": "npm run dev -w api",
    "dev:dashboard": "npm run dev -w dashboard",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  }
}
