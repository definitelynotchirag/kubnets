# All services run via: docker compose -f docker-compose.dev.yaml up -d --build
# These env vars are set automatically in docker-compose.dev.yaml.
# Only needed if running the API outside of Docker.

DATABASE_URL=postgresql://urumi:urumi@localhost:5432/urumi
PORT=3001
KUBECONFIG=~/.kube/config
STORE_DOMAIN=localtest.me
HELM_CHART_PATH=./charts/store
MAX_STORES=5
MAX_CONCURRENT_PROVISIONS=3
