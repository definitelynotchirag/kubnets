# Only needed when running the API outside Docker.
# docker-compose.dev.yaml sets all of these automatically.
#
# All services run via: docker compose -f docker-compose.dev.yaml up -d --build

DATABASE_URL=postgresql://urumi:urumi@localhost:5432/urumi
PORT=3001
# Leave EMPTY to use the standard kubeconfig resolution (kubeconfig loading does not expand "~",
# so a value like "~/.kube/config" would be read as a literal relative path). Set an absolute
# path only when you need a specific file.
KUBECONFIG=

# Store addressing
STORE_DOMAIN=localtest.me
STORE_URL_SCHEME=http

# Store charts
HELM_CHART_PATH_WOOCOMMERCE=./charts/store
HELM_CHART_PATH_MEDUSA=./charts/medusa-store
HELM_VALUES_PROFILE=local

# Readiness probe target.
# Running the API on your host (this file's scenario) means you are OUTSIDE the cluster, so the
# in-cluster Service name is not resolvable: use "ingress" and dial the published ingress.
#   service -> http://<release>-wordpress.<ns>.svc.cluster.local/  (platform running in the cluster)
#   ingress -> http://STORE_PROBE_INGRESS_HOST/ with the store hostname as the Host header
STORE_PROBE_MODE=ingress
# Empty means: dial the store's own hostname, which for *.localtest.me resolves to 127.0.0.1.
STORE_PROBE_INGRESS_HOST=

# Namespaces
PLATFORM_NAMESPACE=urumi-system
INGRESS_NAMESPACE=ingress-nginx

# Abuse controls
MAX_STORES=5
MAX_CONCURRENT_PROVISIONS=3
